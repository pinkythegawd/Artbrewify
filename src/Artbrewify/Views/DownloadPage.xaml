<Page
    x:Class="Artbrewify.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="DownloadPage_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="900">

            <!-- Brand header -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,8">
                <Image x:Name="LogoImage" Width="56" Height="56" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Artbrewify" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandAmberBrush}" />
                    <TextBlock Text="Brew your art collection" Foreground="#B8A99A" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />

            <!-- Source card -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Source" FontSize="16" FontWeight="SemiBold" />
                    <SelectorBar x:Name="PlatformSelector" SelectionChanged="PlatformSelector_SelectionChanged">
                        <SelectorBarItem x:Name="ArtStationItem" Text="ArtStation" Tag="artstation" />
                        <SelectorBarItem x:Name="PixivItem" Text="Pixiv" Tag="pixiv" />
                        <SelectorBarItem x:Name="DeviantArtItem" Text="DeviantArt" Tag="deviantart" />
                    </SelectorBar>
                    <TextBox x:Name="ArtistInput"
                             Header="Artist profile URL, username, or ID"
                             PlaceholderText="e.g. https://www.artstation.com/username"
                             TextChanged="ArtistInput_TextChanged" />
                    <TextBlock x:Name="LoginHint" Foreground="#B8A99A" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Destination card -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Destination" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="FolderButton" Content="Choose folder…" Click="FolderButton_Click" />
                        <TextBlock x:Name="FolderPathText" VerticalAlignment="Center"
                                   Foreground="#B8A99A" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="FetchButton" Content="Fetch gallery" Style="{StaticResource AccentButtonStyle}"
                        Click="FetchButton_Click" MinWidth="140" />
                <Button x:Name="DownloadButton" Content="Download" Click="DownloadButton_Click"
                        IsEnabled="False" MinWidth="120" />
                <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" IsEnabled="False" />
            </StackPanel>

            <!-- Gallery preview -->
            <Border x:Name="SummaryPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    Padding="20" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Text="Gallery preview" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="ArtistNameText" FontSize="15" Foreground="{StaticResource BrandTealBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel>
                            <TextBlock x:Name="ImageCountText" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="images" Foreground="#B8A99A" FontSize="12" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="UgoiraCountText" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="animations" Foreground="#B8A99A" FontSize="12" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="TotalCountText" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandAmberBrush}" />
                            <TextBlock Text="total files" Foreground="#B8A99A" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <Expander Header="Show file list" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" MaxHeight="320">
                        <ListView x:Name="ItemsList" MaxHeight="260" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Progress -->
            <Border x:Name="ProgressPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    Padding="20" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Text="Progress" FontSize="16" FontWeight="SemiBold" />
                    <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#D8C9BA" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <TextBlock x:Name="CompletedText" Foreground="{StaticResource BrandTealBrush}" />
                        <TextBlock x:Name="FailedText" Foreground="{StaticResource BrandCoralBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="CurrentFileText" Foreground="#8A7D70" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>