<Page
    x:Class="Artbrewify.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,8">
                <Image x:Name="LogoImage" Width="64" Height="64" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Artbrewify" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandAmberBrush}" />
                    <TextBlock Text="Brew your art collection · v1.0.0" Foreground="#B8A99A" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#D8C9BA"
                               Text="Artbrewify bulk-downloads an artist's full gallery from ArtStation, Pixiv, and DeviantArt in original quality. It is a rebranded, rebuilt successor to Artify, modernized from .NET Core 3.1 / WPF to .NET 8 / WinUI 3." />
                    <TextBlock TextWrapping="Wrap" Foreground="#8A7D70" FontSize="12"
                               Text="Download artwork for personal archiving only. Respect artists' rights and each platform's terms of service." />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Credits &amp; license" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#D8C9BA"
                               Text="Original Artify © 2020 Rodion Chaykovskiy. Artbrewify © 2026 MikePinku. Both released under the MIT License." />
                    <TextBlock TextWrapping="Wrap" Foreground="#B8A99A" FontSize="13"
                               Text="Pixiv OAuth flow research: azuline/pixiv-api and the pixivpy community. Full-resolution techniques informed by the maintained gallery-dl extractors. Animated GIF encoding by ImageMagick (Magick.NET)." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton Content="Original Artify" NavigateUri="https://github.com/sentouki/Artify" />
                        <HyperlinkButton Content="Artbrewify repo" NavigateUri="https://github.com/pinkythegawd/Artbrewify" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>